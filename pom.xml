<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ─────────────────────────────────────────────────────────────────────
         Project coordinates — Maven uses these three together as a unique ID.
         groupId   : reverse-domain namespace for the organisation / team.
         artifactId: name of this module.
         version   : semantic version; -SNAPSHOT means "in development".
    ───────────────────────────────────────────────────────────────────────── -->
    <groupId>com.apinexus</groupId>
    <artifactId>apinexus-playwright</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>ApiNexus — Playwright Java API Testing Framework</name>
    <description>
        Comprehensive API-testing framework built with Playwright for Java,
        WireMock, TestNG, Jackson, JSON-Schema-Validator, and Logback.
        Covers CRUD, auth, schema, error-handling, pagination, mocking,
        performance, API-chaining, and file-upload scenarios.
    </description>

    <!-- ─────────────────────────────────────────────────────────────────────
         Centralised version properties — change a version here and every
         dependency that references it updates automatically.
    ───────────────────────────────────────────────────────────────────────── -->
    <properties>
        <!-- Java language level used to compile sources -->
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <!-- Force UTF-8 for source files so special chars survive compilation -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions — pinned so builds are reproducible -->
        <playwright.version>1.44.0</playwright.version>
        <testng.version>7.9.0</testng.version>
        <wiremock.version>2.35.0</wiremock.version>
        <jackson.version>2.17.1</jackson.version>
        <json-schema-validator.version>1.3.3</json-schema-validator.version>
        <slf4j.version>2.0.13</slf4j.version>
        <logback.version>1.5.6</logback.version>
        <commons-io.version>2.16.1</commons-io.version>
        <maven-surefire.version>3.2.5</maven-surefire.version>
    </properties>

    <dependencies>

        <!-- ── 1. PLAYWRIGHT for JAVA ─────────────────────────────────────
             Playwright provides browser automation AND a first-class HTTP
             client (APIRequestContext) that we use exclusively for REST
             API testing — no browser is launched.
        ──────────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- ── 2. TestNG ──────────────────────────────────────────────────
             Test execution engine; provides @Test, @BeforeClass, @DataProvider,
             parallel-execution config, and HTML reports out of the box.
        ──────────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- ── 3. WireMock standalone (JRE-8 compatible jar) ─────────────
             Embedded HTTP mock server. We start it programmatically inside
             tests to simulate external services, error conditions, delays,
             and stateful flows — no external process required.
        ──────────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.github.tomakehurst</groupId>
            <artifactId>wiremock-jre8-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ── 4. Jackson Databind ────────────────────────────────────────
             Serialises Java objects → JSON (for request bodies) and
             deserialises JSON → Java objects (for assertions on responses).
        ──────────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ── 5. JSON Schema Validator ───────────────────────────────────
             Validates a JSON document against a JSON Schema (draft-07).
             Used in SchemaValidationTest to assert response structure
             matches the agreed API contract.
        ──────────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>

        <!-- ── 6. SLF4J API ───────────────────────────────────────────────
             Logging facade — production code depends only on this API,
             not on any specific logging implementation.
        ──────────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- ── 7. Logback Classic (SLF4J implementation) ─────────────────
             At runtime Maven picks up Logback as the SLF4J backend.
             Configuration lives in src/test/resources/logback-test.xml.
        ──────────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- ── 8. Apache Commons IO ───────────────────────────────────────
             Simplifies reading test-data files from the classpath
             (e.g. JSON schema files, mock response files).
        ──────────────────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- ── Maven Surefire — runs TestNG tests during mvn test ─────
                 suiteXmlFiles points to our testng.xml which controls which
                 test classes/groups to execute and whether to run in parallel.
            ──────────────────────────────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <!-- All test suites are orchestrated from this file -->
                        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- Show full stack traces in console output -->
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>

            <!-- ── Maven Compiler — ensures Java 11 features are available ─ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <!-- ── Maven Surefire Report — converts XML results into a classic
                 navigable HTML report (target/site/surefire-report.html).
                 Run explicitly with: mvn surefire-report:report
                 This is a second, simpler report alongside the custom
                 Cluecumber-style HTML dashboard generated automatically by
                 CustomReportListener (see src/test/java/com/apinexus/report/).
            ──────────────────────────────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

        </plugins>
    </build>

</project>
